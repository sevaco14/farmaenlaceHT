# Se completa al enlazar Convex (`npx convex dev`). No pongas secretos reales en git.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# WorkOS AuthKit (dashboard del entorno de desarrollo).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Amazon Bedrock (tres agentes en Convex actions). Configúralas en el deployment:
#   npx convex env set AWS_ACCESS_KEY_ID "..."
#   npx convex env set AWS_SECRET_ACCESS_KEY "..."
#   npx convex env set AWS_SESSION_TOKEN "..."   # si el hackathon entrega credenciales temporales
#   npx convex env set AWS_REGION "us-east-1"    # usa la región de tu proyecto AWS
#   npx convex env set BEDROCK_MODEL_ID "amazon.nova-lite-v1:0"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
